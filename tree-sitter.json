{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "practical_gcode",
      "camelcase": "PracticalGcode",
      "title": "Practical G-code",
      "scope": "source.practical-gcode",
      "file-types": ["gcode", "gco", "gc", "g", "rrf", "nc", "ngc", "tap", "cnc"],
      "injection-regex": "^(practical[-_ ]?gcode|gcode|rrf|klipper|cnc)$",
      "class-name": "TreeSitterPracticalGcode"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Practical Marlin, RepRapFirmware, Klipper macro, and RS274/LinuxCNC syntax",
    "authors": [{ "name": "Benjamin Gonzalez" }],
    "links": {
      "repository": "https://github.com/Randomblock1/zed-gcode-suite"
    }
  },
  "bindings": {
    "c": true,
    "node": true
  }
}

